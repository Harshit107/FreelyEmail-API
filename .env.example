PORT=5000

# MongoDB Configuration
# Local: mongodb://localhost:27017/freelyEmail
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/freelyEmail?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017/freelyEmail

# Brevo (formerly Sendinblue) SMTP Configuration
# Official Relay: smtp-relay.brevo.com (port 587 for TLS, 465 for SSL)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# Brevo Credentials (generate SMTP key from: Brevo Dashboard -> SMTP & API -> SMTP)
BREVO_EMAIL=your-brevo-login-email@example.com
BREVO_PASSWORD=your-brevo-smtp-master-key

# Backwards compatibility fallback keys:
# SENDINBLUE_EMAIL=your-brevo-login-email@example.com
# SENDINBLUE_PASSWORD=your-brevo-smtp-master-key

# Brevo API Key (for direct REST API delivery)
BREVO_API_KEY=your-brevo-v3-api-key

# Default verified sender domain & address in Brevo
DEFAULT_FROM_DOMAIN=mail.harshit107.online
DEFAULT_FROM_EMAIL=noreply@mail.harshit107.online

# Centralized Logging Platform Integration
# Microservice URL (Default: http://localhost:5001)
LOGGING_SERVICE_URL=http://localhost:5001
# Authentication key passed in `x-logging-key` header
LOGGING_SERVICE_API_KEY=50b65cea-691b-406e-9d28-0718b86abe98

