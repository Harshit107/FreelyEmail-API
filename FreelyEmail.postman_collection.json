							"raw": "{\n  \"to\": \"recipient@example.com\",\n  \"link\": \"https://harshit107.online/auth/verify?token=example_token_123\",\n  \"subject\": \"Confirm Your Account\",\n  \"buttonText\": \"Verify Email\",\n  \"withValidTime\": 15,\n  \"appName\": \"FreelyEmail Demo\"\n}"
						},
